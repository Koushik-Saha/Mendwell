# Neon pooled connection string (…-pooler…). Used by the app.
DATABASE_URL=
# Optional: Neon direct (unpooled) URL, preferred for migrations.
DATABASE_URL_UNPOOLED=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JSON: {"k1":"<base64 32-byte key>"}. Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KID=
TRIGGER_SECRET_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_VISION=
AI_MODEL_TEXT=
# Email via Mailtrap (API token from Mailtrap → Settings → API Tokens).
# Without a token (development only), emails are written to apps/web/.dev-outbox/.
MAILTRAP_TOKEN=
# Sender on a domain verified in Mailtrap Email Sending, e.g. Mendwell <noreply@your-domain>
EMAIL_FROM=
# Optional: a Mailtrap Email Testing inbox id. Set it to capture mail instead of delivering it (never in production).
MAILTRAP_SANDBOX_INBOX_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SENTRY_DSN=
# Global kill switch. Anything other than exactly "true" pauses all writes.
WRITES_ENABLED=true
APP_URL=http://localhost:3000
