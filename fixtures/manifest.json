{
  "$comment": "Every planted issue in fixtures/sites. Keep in sync with README.md; fixtures.test.ts fails if this drifts from the HTML.",
  "baseUrl": "http://localhost:4000",
  "sites": {
    "clean": {
      "root": "/clean/",
      "description": "Control site. Passes every v1 check; used to catch false positives.",
      "pages": ["/clean/", "/clean/about/"],
      "protectedPaths": [],
      "issues": []
    },
    "messy": {
      "root": "/messy/",
      "description": "Small-business brochure site where every v1 check fires at least once.",
      "pages": ["/messy/", "/messy/services/", "/messy/blog/"],
      "protectedPaths": [],
      "issues": [
        { "id": "messy-lang-home", "check": "html-lang-missing", "page": "/messy/", "target": "html" },
        { "id": "messy-meta-home", "check": "meta-description-missing", "page": "/messy/", "target": "head" },
        { "id": "messy-meta-blog", "check": "meta-description-missing", "page": "/messy/blog/", "target": "head" },
        { "id": "messy-title-dup", "check": "title-duplicate", "page": "/messy/", "target": "title", "duplicateOf": ["/messy/services/"], "value": "Home" },
        { "id": "messy-alt-logo", "check": "img-alt-missing", "page": "/messy/", "target": "img[src=\"/messy/img/logo.svg\"]" },
        { "id": "messy-alt-team", "check": "img-alt-missing", "page": "/messy/", "target": "img[src=\"/messy/img/team.svg\"]" },
        { "id": "messy-alt-van", "check": "img-alt-missing", "page": "/messy/", "target": "img[src=\"/messy/img/van.svg\"]" },
        { "id": "messy-alt-boiler", "check": "img-alt-missing", "page": "/messy/services/", "target": "img[src=\"/messy/img/boiler.svg\"]" },
        { "id": "messy-link-contact", "check": "link-broken-internal", "page": "/messy/", "target": "a[href=\"/messy/contact/\"]", "href": "/messy/contact/", "expectedStatus": 404 },
        { "id": "messy-link-reviews", "check": "link-broken-external", "page": "/messy/", "target": "a[href=\"https://reviews.example.invalid/rivera-plumbing\"]", "href": "https://reviews.example.invalid/rivera-plumbing", "expectedStatus": "dns-failure" },
        { "id": "messy-contrast-home", "check": "color-contrast", "page": "/messy/", "target": "p.faint", "foreground": "#b0b0b0", "background": "#ffffff" },
        { "id": "messy-contrast-services", "check": "color-contrast", "page": "/messy/services/", "target": "p.faint", "foreground": "#b0b0b0", "background": "#ffffff" }
      ]
    },
    "woocommerce": {
      "root": "/woocommerce/",
      "description": "WooCommerce-like shop. Issues on cart, checkout and my-account sit on protected pages and must never be auto-fixed.",
      "pages": [
        "/woocommerce/",
        "/woocommerce/shop/",
        "/woocommerce/product/linen-apron/",
        "/woocommerce/cart/",
        "/woocommerce/checkout/",
        "/woocommerce/my-account/"
      ],
      "protectedPaths": ["/woocommerce/cart/", "/woocommerce/checkout/", "/woocommerce/my-account/"],
      "issues": [
        { "id": "woo-meta-shop", "check": "meta-description-missing", "page": "/woocommerce/shop/", "target": "head" },
        { "id": "woo-alt-shop-apron", "check": "img-alt-missing", "page": "/woocommerce/shop/", "target": "img[src=\"/woocommerce/img/apron.svg\"]" },
        { "id": "woo-alt-shop-mug", "check": "img-alt-missing", "page": "/woocommerce/shop/", "target": "img[src=\"/woocommerce/img/mug.svg\"]" },
        { "id": "woo-link-mug", "check": "link-broken-internal", "page": "/woocommerce/shop/", "target": "a[href=\"/woocommerce/product/stoneware-mug/\"]", "href": "/woocommerce/product/stoneware-mug/", "expectedStatus": 404 },
        { "id": "woo-link-care", "check": "link-broken-external", "page": "/woocommerce/product/linen-apron/", "target": "a[href=\"https://care-guides.example.invalid/linen\"]", "href": "https://care-guides.example.invalid/linen", "expectedStatus": "dns-failure" },
        { "id": "woo-contrast-stock", "check": "color-contrast", "page": "/woocommerce/product/linen-apron/", "target": "p.stock", "foreground": "#9a9a9a", "background": "#fdfdfd" },
        { "id": "woo-meta-cart", "check": "meta-description-missing", "page": "/woocommerce/cart/", "target": "head", "protected": true },
        { "id": "woo-alt-cart", "check": "img-alt-missing", "page": "/woocommerce/cart/", "target": "img[src=\"/woocommerce/img/apron.svg\"]", "protected": true },
        { "id": "woo-meta-checkout", "check": "meta-description-missing", "page": "/woocommerce/checkout/", "target": "head", "protected": true },
        { "id": "woo-alt-checkout", "check": "img-alt-missing", "page": "/woocommerce/checkout/", "target": "img[src=\"/woocommerce/img/card-logos.svg\"]", "protected": true },
        { "id": "woo-contrast-checkout", "check": "color-contrast", "page": "/woocommerce/checkout/", "target": "p.fine-print", "foreground": "#9a9a9a", "background": "#fdfdfd", "protected": true },
        { "id": "woo-meta-account", "check": "meta-description-missing", "page": "/woocommerce/my-account/", "target": "head", "protected": true },
        { "id": "woo-alt-account", "check": "img-alt-missing", "page": "/woocommerce/my-account/", "target": "img[src=\"/woocommerce/img/avatar.svg\"]", "protected": true }
      ]
    }
  }
